# docker compose up --build works with DEMO defaults. Change all secrets before exposure.
MODE=DEMO
POSTGRES_PASSWORD=soc-demo-only
JWT_SECRET=replace-with-a-random-value-of-at-least-32-bytes
WEBHOOK_SECRET=replace-with-long-random-value
DEMO_ADMIN_PASSWORD=admin-demo
DEMO_ANALYST_PASSWORD=analyst-demo
CONNECTED_ADMIN_PASSWORD=
CONNECTED_ANALYST_PASSWORD=
CONNECTED_WRITES_ENABLED=false
CONNECTED_ALLOWED_ACTIONS=
AUTO_CLOSE_ENABLED=false
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
SPLUNK_SEARCH_TEMPLATE=search index=main earliest={earliest} latest={latest} | head 200
SPLUNK_POLL_SECONDS=60
SPLUNK_OVERLAP_SECONDS=120
THEHIVE_BASE_URL=
THEHIVE_API_KEY=
THEHIVE_API_VERSION=
MISP_BASE_URL=
MISP_API_KEY=
# Configure only a local Ollama instance and a model already pulled there.
# With docker compose --profile llm, use OLLAMA_BASE_URL=http://ollama:11434.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=15
OLLAMA_MAX_INPUT_CHARS=12000
OLLAMA_MAX_OUTPUT_BYTES=100000
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_CONCURRENT=2
TIMEZONE=Asia/Qyzylorda
INVESTIGATION_TIMEOUT_SECONDS=90
MAX_EVIDENCE_ITEMS=50
